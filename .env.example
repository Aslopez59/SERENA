# ============================================================
# CONFIGURACIÓN DE CORREO - SERENA UCatólica
# ============================================================

# Correo principal de Bienestar (remitente y destinatario de solicitudes)
SERENA_EMAIL=bienestarucca@gmail.com
BIENESTAR_EMAIL=bienestarucca@gmail.com

# Contraseña de aplicación de Gmail (NO la contraseña normal de la cuenta).
# Para generarla en Gmail:
#   1. Ir a myaccount.google.com → Seguridad
#   2. Activar Verificación en dos pasos (si no está activa)
#   3. Ir a "Contraseñas de aplicaciones"
#   4. Seleccionar "Correo" y "Windows/Mac" → Generar
#   5. Copiar la contraseña de 16 caracteres aquí abajo
SERENA_EMAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Servidor SMTP de Gmail (no cambiar)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
